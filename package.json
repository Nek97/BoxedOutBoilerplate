{
  "name": "boxedout-core-api",
  "version": "3.2.1-rc1.119",
  "description": "BoxedOut Core API",
  "author": "BoxedOut",
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "inherits": [
    "libs/common/package.json"
  ],
  "workspaces": [
    "apps/cli",
    "apps/manage-panel",
    "apps/user-provider",
    "apps/kafka-app",
    "libs/common",
    "libs/common/ag-grid",
    "libs/common/aws-helpers",
    "libs/common/data-loader",
    "libs/common/database",
    "libs/common/field-middleware",
    "libs/common/graphql",
    "libs/common/interfaces",
    "libs/common/jest",
    "libs/common/logger",
    "libs/common/types",
    "libs/common/utils",
    "apps/skeleton-app",
    "apps/documentation"
  ],
  "scripts": {
    "preinstall": "npm run setup:git",
    "install:workspaces": "npm install --workspaces --include-workspace-root",
    "update:package-lock": "npm i --package-lock-only",
    "update:workspaces:lock": "npm exec -ws -- npm i --package-lock-only",
    "update:workspaces": "npm update --workspaces --include-workspace-root",
    "version": "echo $npm_package_version",
    "version:rc:minor": "npm version prerelease --preid=rc1",
    "pkg:add": "npm install --package-lock-only --no-package-lock --prefix",
    "postpkg:add": "npm install",
    "set:proj": "npm set bcaproj",
    "get:proj": "npm get bcaproj",
    "git:sub": "git submodule update --init --recursive && git submodule update --recursive && git submodule sync",
    "nest:gen": "cross-var nest generate $npm_config_type $npm_config_name modules",
    "build": "cross-var nest build ${npm_config_bcaproj:-all} -- ",
    "build:bundle:fix": "rimraf env/dist/apps/${npm_config_bcaproj:-all}/bundle/database* && rimraf env/dist/apps/${npm_config_bcaproj:-all}/bundle/config",
    "build:bundle": "npm run build && rimraf env/dist/apps/${npm_config_bcaproj:-all}/bundle && cross-var node utils/ncc.js env/dist/apps/${npm_config_bcaproj:-all}/src/main.js env/dist/apps/${npm_config_bcaproj:-all}/bundle && npm run build:bundle:fix",
    "build:bundle:ts": "npm run build && rimraf env/dist/apps/${npm_config_bcaproj:-all}/bundle && cross-var node utils/ncc.js apps/${npm_config_bcaproj:-all}/src/main.ts env/dist/apps/${npm_config_bcaproj:-all}/bundle && npm run build:bundle:fix",
    "build:bundle:webpack": "cross-var nest build --webpack ${npm_config_bcaproj:-all} -- ",
    "clean:all": "npm run clean:test && npm run clean:build && npm run clean:docs && npm run clean:deps",
    "clean:test": "npx jest --clearCache",
    "clean:deps": "rimraf node_modules/*",
    "docs:start": "npm run start --workspace=apps/documentation",
    "docs:build": "npm run build --workspace=apps/documentation",
    "prebuild": "rimraf dist",
    "clean:docs": "rimraf docs/compodoc/*",
    "cli": "cross-env TS_NODE_PROJECT=apps/cli/tsconfig.json ts-node apps/cli/src/main.ts",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:all": "nest start all",
    "start:all:dev": "nest start --watch all",
    "start": "cross-var nest start ${npm_config_bcaproj:-all} -- ",
    "start:dev": "cross-var nest start --watch ${npm_config_bcaproj:-all} -- ",
    "start:debug": "cross-var nest start --debug --watch ${npm_config_bcaproj:-all} -- ",
    "start:prod": "cross-var node --trace-deprecation -r ./tsconfig-paths-bs.js env/dist/apps/${npm_config_bcaproj:-all}/src/main.js",
    "lint": "npm run lint:no-fix -- --fix",
    "lint:no-fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "lint:path": "eslint $npm_config_lintpath\"/**/*.ts\" --max-warnings=0",
    "test": "node --expose-gc 'node_modules/.bin/jest' --logHeapUsage ",
    "test:detect": "npm run test -- --detectOpenHandles --forceExit --verbose ",
    "test:debug": "node --expose-gc --inspect-brk=0.0.0.0:9229 'node_modules/.bin/jest' --verbose --logHeapUsage --runInBand --detectOpenHandles --forceExit ",
    "test:vscode": "node test/jest.js",
    "test:watch": "npm run test -- --watch",
    "test:cov": "npm run test -- --coverage",
    "test:e2e": "cross-var npm run test -- --config=test/jest-e2e.config.ts --verbose -t ",
    "test:e2e:detect": "npm run test:e2e -- --detectOpenHandles --forceExit -t ",
    "test:e2e:debug": "cross-var npm run test:debug -- --config=test/jest-e2e.config.ts --verbose --detectOpenHandles --forceExit -t ",
    "test:e2e:autoupdate": "cross-env UPDATE_QUERIES=true cross-var npm run test -- --config=test/jest-e2e.config.ts -t auto-tests.e2e",
    "test:cov:serve": "npx http-server -p 60002 -c-1 ./docs/compodoc/jestcoverage/",
    "doc:test": "npx @compodoc/compodoc --coverageTest 0",
    "doc:gen": "npx @compodoc/compodoc",
    "doc:gen:gqlapi": "jest --silent=false --detectOpenHandles --forceExit --config apps/gateway/test/feature/jest-extra.conf.ts",
    "doc:serve": "npm run doc:gen -- -s -w --port 60001",
    "check:all": "npm run clean:test && npm run build && npm run lint && npm run test:e2e && npm run test:cov && npm run doc:test",
    "typeorm": "ts-node --files ./node_modules/typeorm/cli.js",
    "typeorm:query": "npm run typeorm:cli -- query -- ",
    "typeorm:schema:sync": "npm run cli -- sync",
    "typeorm:initdb": "npm run cli -- create --withSchema",
    "typeorm:drop": "npm run cli -- drop",
    "typeorm:reset": "npm run typeorm:drop && npm run typeorm:initdb",
    "typeorm:migrate": "npm run cli -- migrate",
    "typeorm:generate": "npm run cli -- generate",
    "typeorm:generate:migration": "typeorm migration:create",
    "typeorm:reseed": "npm run cli -- seed --reseed",
    "docker:compose": "docker compose",
    "docker:start": "npm run docker:compose -- up ",
    "docker:start:d": "npm run docker:start -- -d",
    "docker:start:extra": "npm run docker:compose -- --profile extra up -d",
    "docker:update": "npm run docker:compose -- pull && npm run docker:compose -- down",
    "docker:shell": "npm run docker:start:d && npm run docker:compose -- exec boxed-out-boilerplate bash || true",
    "docker:set:proj": "npx cross-var npm run docker:compose -- run --rm boxed-out-boilerplate npm run set:proj $npm_config_id || true",
    "docker:get:proj": "npx cross-var npm run docker:compose -- run --rm boxed-out-boilerplate npm run get:proj || true",
    "docker:doc": "npm run docker:compose -- run --rm boxed-out-boilerplate npm run doc:serve || true",
    "docker:initdb": "npm run docker:compose -- run --rm boxed-out-boilerplate npm run typeorm:initdb || true",
    "docker:dropdb": "npm run docker:compose -- run --rm boxed-out-boilerplate npm run typeorm:drop || true",
    "docker:resetdb": "npm run docker:compose -- run --rm boxed-out-boilerplate npm run typeorm:reset || true",
    "docker:reseed": "npm run docker:compose -- run --rm boxed-out-boilerplate npm run typeorm:reseed || true",
    "docker:migrate": "npm run docker:compose -- run --rm boxed-out-boilerplate npm run typeorm:migrate || true",
    "docker:start:phpmyadmin": "npm run docker:compose -- up phpmyadmin",
    "docker:stop": "npm run docker:compose -- stop",
    "docker:remove": "npm run docker:compose -- down --rmi all -v --remove-orphans",
    "docker:logs": "npm run docker:compose -- logs --follow --tail 200",
    "tool:pkg:check": "npx npm-check -u",
    "tool:circular:check": "npx madge --circular --extensions ts ./",
    "setup:git": "node utils/npm_scripts.js setup:git"
  },
  "dependencies": {
    "@apollo/federation": "^0.33.3",
    "@apollo/subgraph": "^0.1.2",
    "@aws-sdk/client-dynamodb": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1106.0",
    "@graphql-tools/wrap": "^8.3.0",
    "@kafkajs/confluent-schema-registry": "^3.2.1",
    "@nestjs-yalc/framework": "file:libs/common",
    "@nestjs/axios": "^0.0.8",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^8.1.1",
    "@nestjs/config": "^1.0.2",
    "@nestjs/core": "^8.1.1",
    "@nestjs/event-emitter": "^1.0.0",
    "@nestjs/graphql": "^9.1.1",
    "@nestjs/jwt": "^8.0.0",
    "@nestjs/microservices": "^8.3.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^8.0.1",
    "@nestjs/platform-fastify": "^8.1.1",
    "@nestjs/schedule": "^1.1.0",
    "@nestjs/swagger": "^5.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^8.0.2",
    "@sendgrid/client": "^7.2.1",
    "@sentry/node": "^6.7.1",
    "@sentry/tracing": "^6.7.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "apollo-server-fastify": "^3.4.0",
    "auth0": "^2.40.0",
    "aws-lambda-fastify": "^1.4.4",
    "axios": "^0.27.2",
    "bcrypt": "^5.0.1",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^7.2.9",
    "change-case": "^4.1.2",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "commander": "^7.2.0",
    "compare-versions": "^3.6.0",
    "country-data": "^0.0.31",
    "csurf": "^1.11.0",
    "dataloader": "^2.0.0",
    "decimal.js": "^10.3.1",
    "faker": "^5.5.2",
    "fast-levenshtein": "^2.0.6",
    "fastify-cookie": "^5.3.1",
    "fastify-swagger": "^5.2.0",
    "firebase-admin": "^13.10.0",
    "google-libphonenumber": "^3.2.21",
    "graphql": "^15.5.3",
    "graphql-type-json": "^0.3.2",
    "iban": "^0.0.14",
    "jszip": "^3.5.0",
    "jwks-rsa": "^2.1.2",
    "kafkajs": "^1.16.0",
    "kafkajs-snappy": "^1.1.0",
    "lodash": "^4.18.1",
    "mobile-detect": "^1.4.4",
    "mongoose": "^8.24.2",
    "mysql2": "^2.3.2",
    "node-fetch": "^2.6.1",
    "notp": "^2.0.3",
    "p-map": "^4.0.0",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "pino": "^6.11.0",
    "prom-client": "^15.1.3",
    "querystring": "^0.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.4.0",
    "thirty-two": "^1.0.2",
    "typeorm": "^0.2.41",
    "typeorm-model-generator": "^0.4.5",
    "typeorm-seeding": "^1.6.1",
    "ua-parser-js": "^1.0.2",
    "user-agent-parser": "^0.6.0",
    "uuid": "^8.3.2",
    "validator": "^13.7.0",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "@boxedout-apps/cli": "file:apps/cli",
    "@compodoc/compodoc": "^1.1.18",
    "@jest/create-cache-key-function": "^26.6.2",
    "@nestjs/cli": "^8.2.1",
    "@nestjs/schematics": "^8.0.5",
    "@nestjs/testing": "^8.1.1",
    "@types/auth0": "^2.34.19",
    "@types/aws-lambda": "^8.10.88",
    "@types/bcrypt": "^5.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/boxedout-libs": "libs/boxedout-libs/types-boxedout",
    "@types/concurrently": "^6.3.0",
    "@types/country-data": "^0.0.2",
    "@types/cron": "^1.7.3",
    "@types/decimal.js": "^7.4.0",
    "@types/faker": "^5.5.3",
    "@types/inquirer": "^8.1.3",
    "@types/lodash": "^4.17.25",
    "@types/nestjs-yalc": "libs/common/types",
    "@types/node": "^16.11.39",
    "@types/node-fetch": "^2.5.4",
    "@types/notp": "^2.0.2",
    "@types/passport": "^1.0.6",
    "@types/passport-jwt": "^3.0.5",
    "@types/pino": "^6.3.5",
    "@types/supertest": "^2.0.10",
    "@types/ua-parser-js": "^0.7.36",
    "@types/uuid": "^8.3.4",
    "@types/validator": "^13.7.2",
    "@vercel/ncc": "^0.33.0",
    "concurrently": "^6.3.0",
    "copy-webpack-plugin": "^7.0.0",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0",
    "http-server": "^13.0.1",
    "inquirer": "^7.3.3",
    "jest": "^27.5.1",
    "rimraf": "^3.0.2",
    "serverless-dotenv-plugin": "^3.8.1",
    "serverless-offline": "^8.2.0",
    "serverless-plugin-optimize": "^4.1.4-rc.1",
    "serverless-webpack": "^5.3.5",
    "source-map": "^0.7.3",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.6",
    "ts-jest": "^27.1.5",
    "tsconfig-paths": "^3.9.0",
    "tsconfig-paths-webpack-plugin": "^3.5.2",
    "webpack-cli": "^4.5.0",
    "webpack-node-externals": "^2.5.2"
  }
}