#
# copy the following conf
# inside .env file of the root directory
# to change some docker-compose configurations
#

# nestjs external ports
DOCKER_PORT_GATEWAY=
DOCKER_PORT_MANAGE_PANEL=
# sls service external port
DOCKER_PORT_SLS=
# compodoc service external port
DOCKER_PORT_DOC=
# coverage service external port
DOCKER_PORT_COV=
# mysql external port
DOCKER_MYSQL_PORT=
# mysql insternal network alias
DOCKER_MYSQL_HOST_ALIAS=
# redis external port
DOCKER_REDIS_PRICING_PORT=
# phpmyadmin external port 
DOCKER_PMA_PORT=
# mysql-test external port
DOCKER_PORT_MYSQL_TEST=



# Polyglot Persistence configs
