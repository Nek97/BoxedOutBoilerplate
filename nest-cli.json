{
    "collection":  "@nestjs/schematics",
    "compilerOptions":  {
                            "deleteOutDir":  false,
                            "webpack":  false,
                            "plugins":  [
                                            {
                                                "name":  "@nestjs/graphql",
                                                "options":  {
                                                                "typeFileNameSuffix":  [
                                                                                           ".input.ts",
                                                                                           ".args.ts",
                                                                                           ".entity.ts",
                                                                                           ".type.ts"
                                                                                       ],
                                                                "introspectComments":  true
                                                            }
                                            },
                                            {
                                                "name":  "@nestjs/swagger/plugin",
                                                "options":  {
                                                                "classValidatorShim":  true,
                                                                "dtoFileNameSuffix":  [
                                                                                          ".type.ts"
                                                                                      ]
                                                            }
                                            }
                                        ]
                        },
